<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>${groupId}</groupId>
  <artifactId>${rootArtifactId}</artifactId>
  <version>${version}</version>
  <packaging>pom</packaging>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.source>${javaVersion}</maven.compiler.source>
    <maven.compiler.target>${javaVersion}</maven.compiler.target>
    <maven.compiler.plugin.version>${compilerPluginVersion}</maven.compiler.plugin.version>

    <!-- springboot -->
    <spring.boot.version>3.5.11</spring.boot.version>

    <!--        websocket-->
    <org.springframework.websocket.version>2.5.15</org.springframework.websocket.version>
  </properties>

<!--  统一管理所有依赖的版本 -->
  <dependencyManagement>
    <dependencies>
      <!-- 配置 common 模块版本 -->
      <dependency>
        <groupId>${groupId}</groupId>
        <artifactId>${rootArtifactId}-common</artifactId>
        <version>${project.version}</version> <!-- 复用父模块版本，无需硬编码 -->
      </dependency>

      <!-- 配置 model 模块版本 -->
      <dependency>
        <groupId>${groupId}</groupId>
        <artifactId>${rootArtifactId}-model</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- 配置 repository 模块版本 -->
      <dependency>
        <groupId>${groupId}</groupId>
        <artifactId>${rootArtifactId}-repository</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- 配置 service 模块版本 -->
      <dependency>
        <groupId>${groupId}</groupId>
        <artifactId>${rootArtifactId}-service</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- 配置 controller 模块版本 -->
      <dependency>
        <groupId>${groupId}</groupId>
        <artifactId>${rootArtifactId}-controller</artifactId>
        <version>${project.version}</version>
      </dependency>


      <!--      springboot pom-->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Source: https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-websocket -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-websocket</artifactId>
        <version>${org.springframework.websocket.version}</version>
        <scope>compile</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <!--
     构建配置部分，用于定义项目的构建相关信息。
     该部分通常包含插件管理、资源过滤、目录结构等配置。
   -->
  <build>
    <!--
  插件管理部分，用于统一管理项目中使用的Maven插件及其版本。
  通过在此处声明插件，可以在子模块中复用，避免重复配置。
-->
  <pluginManagement>
  <plugins>
    <!--
       Maven 编译器插件配置。
       该插件用于编译 Java 源代码，支持指定 Java 版本和其他编译选项。
     -->
  <plugin>
    <groupId>org.apache.maven.plugins</groupId>
    <artifactId>maven-compiler-plugin</artifactId>
    <version>${maven.compiler.plugin.version}</version>
    <configuration>
      <source>${javaVersion}</source>
      <target>${javaVersion}</target>
      <encoding>UTF-8</encoding>
    </configuration>
  </plugin>
  </plugins>
</pluginManagement>
  </build>
    <modules>
      <module>${rootArtifactId}-common</module>
      <module>${rootArtifactId}-model</module>
      <module>${rootArtifactId}-repository</module>
      <module>${rootArtifactId}-service</module>
      <module>${rootArtifactId}-controller</module>
  </modules>


  <!--  配置 私库信息-->
  <repositories>
    <repository>
      <id>bobby-group</id>
      <name>personal maven</name>
      <url>http://173.16.10.2:10086/repository/bobby-group/</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>
</project>
