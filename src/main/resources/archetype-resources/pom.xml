<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>${groupId}</groupId>
  <artifactId>${rootArtifactId}</artifactId>
  <version>${version}</version>
  <packaging>pom</packaging>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.source>${javaVersion}</maven.compiler.source>
    <maven.compiler.target>${javaVersion}</maven.compiler.target>
    <maven.compiler.plugin.version>${compilerPluginVersion}</maven.compiler.plugin.version>
  </properties>

<!--  统一管理所有依赖的版本 -->
  <dependencyManagement>
    <dependencies>
      <!-- 配置 common 模块版本 -->
      <dependency>
        <groupId>${groupId}</groupId>
        <artifactId>${rootArtifactId}-common</artifactId>
        <version>${project.version}</version> <!-- 复用父模块版本，无需硬编码 -->
      </dependency>

      <!-- 配置 model 模块版本 -->
      <dependency>
        <groupId>${groupId}</groupId>
        <artifactId>${rootArtifactId}-model</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- 配置 repository 模块版本 -->
      <dependency>
        <groupId>${groupId}</groupId>
        <artifactId>${rootArtifactId}-repository</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- 配置 service 模块版本 -->
      <dependency>
        <groupId>${groupId}</groupId>
        <artifactId>${rootArtifactId}-service</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- 配置 controller 模块版本 -->
      <dependency>
        <groupId>${groupId}</groupId>
        <artifactId>${rootArtifactId}-controller</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <!--
     构建配置部分，用于定义项目的构建相关信息。
     该部分通常包含插件管理、资源过滤、目录结构等配置。
   -->
  <build>
    <!--
  插件管理部分，用于统一管理项目中使用的Maven插件及其版本。
  通过在此处声明插件，可以在子模块中复用，避免重复配置。
-->
  <pluginManagement>
  <plugins>
    <!--
       Maven编译器插件配置。
       该插件用于编译Java源代码，支持指定Java版本和其他编译选项。
     -->
  <plugin>
    <groupId>org.apache.maven.plugins</groupId>
    <artifactId>maven-compiler-plugin</artifactId>
    <version>${maven.compiler.plugin.version}</version>
  </plugin>
  </plugins>
</pluginManagement>
  </build>
    <modules>
      <module>${rootArtifactId}-common</module>
      <module>${rootArtifactId}-model</module>
      <module>${rootArtifactId}-repository</module>
      <module>${rootArtifactId}-service</module>
      <module>${rootArtifactId}-controller</module>
  </modules>
</project>
