<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.bobby</groupId>
  <artifactId>layered-multi-module-archetype</artifactId>
  <!-- 版本添加SNAPSHOT，区分开发版/正式版，适配Maven仓库规范 -->
  <version>1.0.1</version>
  <packaging>maven-archetype</packaging>

  <name>Archetype - layered-multi-module-archetype</name>
  <!--项目描述、URL、开发者信息，符合Maven项目规范，提升可维护性 -->
  <description>Maven Archetype for Java Layered Multi-Module Project（分层多模块项目原型）</description>
  <url>https://github.com/yidongdematong/layered-multi-module-archetype</url>
  <developers>
    <developer>
      <id>bobby</id>
      <name>Bobby</name>
      <email>yidongdematong@gmail.com</email>
      <url>https://github.com/yidongdematong</url>
    </developer>
  </developers>


  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <!-- 统一插件版本，抽离为属性，便于后续维护升级 -->
    <archetype.version>3.2.1</archetype.version>
    <maven.plugin.version>3.1.2</maven.plugin.version>
    <clean.plugin.version>3.4.0</clean.plugin.version>
    <resources.plugin.version>3.3.1</resources.plugin.version>
    <!-- 跳过集成测试 -->
    <maven.test.skip>true</maven.test.skip>
  </properties>

  <build>
    <extensions>
      <extension>
        <groupId>org.apache.maven.archetype</groupId>
        <artifactId>archetype-packaging</artifactId>
        <!-- 最新稳定版3.2.1，修复3.2.0的部分已知bug -->
        <version>${archetype.version}</version>
      </extension>
    </extensions>

    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${clean.plugin.version}</version>
        </plugin>
        <!-- 核心：maven-archetype-plugin，原型的安装/生成核心插件 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-archetype-plugin</artifactId>
          <version>${archetype.version}</version>
          <!-- 添加插件配置，强制校验原型配置，避免配置错误 -->
<!--          <configuration>-->
<!--            <ignoreOldFormat>true</ignoreOldFormat>-->
<!--          </configuration>-->
          <!-- 绑定archetype:jar目标，生成原型jar包，适配仓库发布 -->
          <executions>
            <execution>
              <goals>
                <goal>jar</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${resources.plugin.version}</version>
          <!-- 配置资源过滤，保证archetype-resources中模板文件的编码和属性替换 -->
          <configuration>
            <encoding>UTF-8</encoding>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven.plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <!-- 显式声明构建插件，让Maven执行archetype相关目标 -->
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-archetype-plugin</artifactId>
        <version>${archetype.version}</version>
      </plugin>
    </plugins>
  </build>

<!--  配置 私库信息-->
  <distributionManagement>
<!--    正式版地址-->
    <repository>
      <id>bobby-group</id>
      <name>personal maven</name>
      <url>http://173.16.10.2:10086/repository/bobby-hosted/</url>
    </repository>
<!--    <snapshotRepository>-->
<!--      <id>bobby-group</id>-->
<!--      <name>personal maven</name>-->
<!--      <url>http://127.0.0.1:10086/repository/bobby-snapshots/</url>-->
<!--    </snapshotRepository>-->
  </distributionManagement>
</project>
